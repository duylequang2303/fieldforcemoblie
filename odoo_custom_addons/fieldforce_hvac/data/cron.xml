<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron to process ZNS message queue -->
        <record id="ir_cron_process_zns_queue" model="ir.cron">
            <field name="name">Zalo ZNS Outbox Processing Queue</field>
            <field name="model_id" ref="model_x_hvac_zns_message"/>
            <field name="state">code</field>
            <field name="code">model.process_zns_messages()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>

        <!-- Cron to refresh Zalo OA tokens weekly -->
        <record id="ir_cron_refresh_zalo_tokens" model="ir.cron">
            <field name="name">Zalo OA Tokens Auto-Refresh (Weekly)</field>
            <field name="model_id" ref="model_x_hvac_zns_message"/>
            <field name="state">code</field>
            <field name="code">model.refresh_zalo_tokens()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>