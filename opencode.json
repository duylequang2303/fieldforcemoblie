{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    ".agents/AGENTS.md",
    ".agents/rules/*.md",
    ".agent-rules/*.md"
  ],
  "tool_output": {
    "max_lines": 2000,
    "max_bytes": 51200
  },
  "compaction": {
    "auto": true
  },
  "mcp": {
    "odoo": {
      "type": "local",
      "command": ["npx", "-y", "odoo-mcp-server@1.1.0"],
      "enabled": true,
      "environment": {
        "ODOO_URL": "{env:ODOO_URL}",
        "ODOO_DB": "{env:ODOO_DB}",
        "ODOO_USERNAME": "{env:ODOO_USERNAME}",
        "ODOO_PASSWORD": "{env:ODOO_PASSWORD}"
      },
      "tools": {
        "read": ["odoo_search", "odoo_search_read", "odoo_read", "odoo_search_count"],
        "write": ["odoo_create", "odoo_write", "odoo_unlink", "odoo_execute_kw"]
      }
    },
    "dart": {
      "type": "local",
      "command": ["dart", "mcp-server"],
      "enabled": true
    }
  },
  "permission": {
    "bash": {
      "*": "deny",
      "git --no-pager diff": "allow",
      "git --no-pager diff --cached": "allow",
      "git status": "allow",
      "git log*": "allow"
    }
  }
}
