{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "plan": {
      "model": "omniroute/free-stack"
    },
    "build": {
      "model": "opencode/nemotron-3.5-lightning-free"
    }
  },
  "skills": {
    "paths": [
      ".agents/skills"
    ]
  },
  "instructions": [
    ".agents/AGENTS.md",
    ".agents/rules/*.md",
    ".agent-rules/*.md"
  ],
  "tool_output": {
    "max_lines": 2000,
    "max_bytes": 51200
  },
  "compaction": {
    "auto": true
  },
  "mcp": {
    "odoo": {
      "type": "local",
      "command": ["npx", "-y", "odoo-mcp-server@1.1.0"],
      "enabled": true,
      "environment": {
        "ODOO_URL": "{env:ODOO_URL}",
        "ODOO_DB": "{env:ODOO_DB}",
        "ODOO_USERNAME": "{env:ODOO_USERNAME}",
        "ODOO_PASSWORD": "{env:ODOO_PASSWORD}"
      }
    },
    "dart": {
      "type": "local",
      "command": ["dart", "mcp-server"],
      "enabled": true
    }
  },
  "permission": {
    "bash": {
      "*": "deny",
      "git --no-pager diff": "allow",
      "git --no-pager diff --cached": "allow",
      "git status": "allow",
      "git add *": "ask",
      "git commit -m *": "ask",
      "git log*": "allow"
    },
    "odoo_search": "allow",
    "odoo_search_read": "allow",
    "odoo_read": "allow",
    "odoo_search_count": "allow",
    "odoo_create": "ask",
    "odoo_write": "ask",
    "odoo_unlink": "deny",
    "odoo_execute_kw": "ask"
  }
}
