{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    ".agents/AGENTS.md",
    ".agents/rules/*.md",
    ".agent-rules/*.md"
  ],
  "tool_output": {
    "max_lines": 200,
    "max_bytes": 8192
  },
  "compaction": {
    "auto": true
  },
  "mcp": {
    "odoo": {
      "type": "local",
      "command": ["npx", "-y", "odoo-mcp-server"],
      "enabled": true,
      "environment": {
        "ODOO_URL": "${ODOO_URL}",
        "ODOO_DB": "${ODOO_DB}",
        "ODOO_USERNAME": "${ODOO_USERNAME}",
        "ODOO_PASSWORD": "${ODOO_PASSWORD}"
      }
    },
    "dart": {
      "type": "local",
      "command": ["dart", "mcp-server"],
      "enabled": true
    }
  },
  "permission": {
    "bash": {
      "flutter *": "allow",
      "dart *": "allow",
      "git status": "allow",
      "git diff*": "allow",
      "git log*": "allow"
    }
  }
}
