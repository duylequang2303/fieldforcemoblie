<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31): allowBackup only covers cloud backup, device-to-device
     transfer must be excluded separately. The Isar cache holds offline customer
     orders, signatures and receipt photos, so nothing may leave the device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
