{
  "mcpServers": {
    "a2a-platform": {
      "disabled": false,
      "timeout": 90,
      "type": "sse",
      "url": "https://agent-router-backend-1023201593264.europe-west1.run.app/mcp/sse",
      "headers": {
        "Authorization": "${A2A_PLATFORM_TOKEN}"
      }
    },
    "dart": {
      "command": "dart",
      "args": ["mcp-server"],
      "timeout": 60,
      "type": "stdio"
    },
    "odoo": {
      "command": "npx",
      "args": ["-y", "odoo-mcp-server"],
      "timeout": 60,
      "type": "stdio",
      "env": {
        "ODOO_URL": "${ODOO_URL}",
        "ODOO_DB": "${ODOO_DB}",
        "ODOO_USERNAME": "${ODOO_USERNAME}",
        "ODOO_PASSWORD": "${ODOO_PASSWORD}"
      }
    }
  }
}